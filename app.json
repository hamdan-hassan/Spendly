{
  "expo": {
    "name": "Spendly - Budget & Expense Tracker",
    "description": "Track daily expenses, manage your money, and achieve financial goals offline. The ultimate personal finance, budget planner, and daily expense tracker app.",
    "slug": "Spendly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spendly",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0E1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.hamdanhassan.spendly"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.hamdanhassan.spendly"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0E1A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-sharing",
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#6366F1"
        }
      ],
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4478899815710413~5485105432",
          "iosAppId": "ca-app-pub-4478899815710413~5485105432"
        }
      ],
      "expo-build-properties",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "768be88d-61f8-4fc5-94a5-6fd3fbec98ec"
      }
    }
  }
}